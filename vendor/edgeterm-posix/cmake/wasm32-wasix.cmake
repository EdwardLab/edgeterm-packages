set(CMAKE_SYSTEM_NAME WASI)
set(CMAKE_SYSTEM_PROCESSOR wasm32)
set(UNIX TRUE)
set(WIN32 FALSE)
set(CMAKE_PROJECT_INCLUDE "$ENV{EDGETERM_POSIX_PREFIX}/share/edgeterm-posix/cmake/project-platform.cmake")

set(CMAKE_C_COMPILER "$ENV{WASI_SDK_BIN}/clang")
set(CMAKE_CXX_COMPILER "$ENV{WASI_SDK_BIN}/clang++")
set(CMAKE_C_COMPILER_TARGET wasm32-wasip1)
set(CMAKE_CXX_COMPILER_TARGET wasm32-wasip1)
set(CMAKE_AR "$ENV{WASI_SDK_BIN}/llvm-ar")
set(CMAKE_RANLIB "$ENV{WASI_SDK_BIN}/llvm-ranlib")

set(CMAKE_SYSROOT "$ENV{WASIX_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH
    "$ENV{WASIX_SYSROOT}"
    "$ENV{EDGETERM_POSIX_PREFIX}"
    "$ENV{EDGETERM_PREFIX}")
set(CMAKE_INCLUDE_PATH
    "$ENV{WASIX_SYSROOT}/include"
    "$ENV{EDGETERM_POSIX_PREFIX}/include"
    "$ENV{EDGETERM_PREFIX}/include")
set(CMAKE_LIBRARY_PATH
    "$ENV{WASIX_SYSROOT}/lib/wasm32-wasip1"
    "$ENV{WASIX_SYSROOT}/lib/wasm32-wasi"
    "$ENV{EDGETERM_POSIX_PREFIX}/lib"
    "$ENV{EDGETERM_PREFIX}/lib")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

if(NOT DEFINED ENV{EDGETERM_POSIX_FLAGS_IN_ENV})
    set(_EDGETERM_POSIX_COMPILE
        "-isystem $ENV{EDGETERM_POSIX_PREFIX}/include")
    set(_EDGETERM_POSIX_LINK
        "-Wl,--whole-archive $ENV{EDGETERM_POSIX_PREFIX}/lib/libedgeterm-posix.a -Wl,--no-whole-archive")
    set(CMAKE_C_FLAGS_INIT "${_EDGETERM_POSIX_COMPILE}")
    set(CMAKE_CXX_FLAGS_INIT "${_EDGETERM_POSIX_COMPILE}")
    set(CMAKE_EXE_LINKER_FLAGS_INIT
        "-Wl,--export=__stack_pointer -Wl,--export=__heap_base -Wl,--export=__data_end ${_EDGETERM_POSIX_LINK}")
endif()
set(CMAKE_CXX_STANDARD_LIBRARIES "-lc++ -lc++abi")
