{
  "arch": "wasm32",
  "binary-format": "wasm",
  "crt-objects-fallback": "true",
  "crt-static-allows-dylibs": true,
  "crt-static-default": true,
  "crt-static-respected": true,
  "data-layout": "e-m:e-p:32:32-p10:8:8-p20:8:8-i64:64-i128:128-n32:64-S128-ni:1:10:20",
  "dll-prefix": "",
  "dll-suffix": ".wasm",
  "dynamic-linking": true,
  "eh-frame-header": false,
  "emit-debug-gdb-scripts": false,
  "entry-name": "__main_void",
  "exe-suffix": ".wasm",
  "generate-arange-section": false,
  "has-thread-local": false,
  "is-like-wasm": true,
  "linker": "rust-lld",
  "linker-flavor": "wasm-lld",
  "linker-is-gnu": false,
  "lld-flavor": "wasm",
  "llvm-args": [],
  "llvm-target": "wasm32-wasi",
  "main-needs-argc-argv": false,
  "max-atomic-width": 64,
  "metadata": {
    "description": "Single-threaded WASIX command target for EdgeTerm",
    "host_tools": false,
    "std": null,
    "tier": null
  },
  "only-cdylib": true,
  "os": "wasi",
  "panic-strategy": "abort",
  "pre-link-args": {
    "wasm-lld": [
      "-z",
      "stack-size=1048576",
      "--stack-first",
      "--no-demangle",
      "--export-if-defined=__indirect_function_table",
      "--no-check-features"
    ],
    "wasm-lld-cc": [
      "-Wl,-z",
      "-Wl,stack-size=1048576",
      "-Wl,--stack-first",
      "-Wl,--no-demangle",
      "--target=wasm32-wasi",
      "-Wl,--export-if-defined=__indirect_function_table",
      "-Wl,--no-check-features"
    ]
  },
  "pre-link-objects-fallback": {
    "dynamic-dylib": ["scrt1.o"],
    "dynamic-nopic-exe": ["/build/edgeterm-rust-crt1.o"],
    "dynamic-pic-exe": ["/build/edgeterm-rust-crt1.o"],
    "static-dylib": ["scrt1.o"],
    "static-nopic-exe": ["/build/edgeterm-rust-crt1.o"],
    "static-pic-exe": ["/build/edgeterm-rust-crt1.o"],
    "wasi-reactor-exe": ["crt1-reactor.o"]
  },
  "relocation-model": "static",
  "singlethread": true,
  "target-family": ["wasm"],
  "target-pointer-width": 32,
  "vendor": "wasmer"
}
