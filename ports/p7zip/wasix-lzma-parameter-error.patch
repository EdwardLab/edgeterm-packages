+WRes Thread_Create(CThread *thread, THREAD_FUNC_TYPE startAddress, LPVOID parameter)
+{
+  thread->_created = 1;
+  (void)startAddress(parameter);
+  return 0;
+}
+
+WRes Thread_Wait(CThread *thread)
+{
+  thread->_created = 0;
+  return 0;
+}
+
+WRes Thread_Close(CThread *thread)
+{
+  thread->_created = 0;
+  return 0;
+}
+
+WRes Event_Create(CEvent *p, BOOL manualReset, int initialSignaled)
+{
+  p->_manual_reset = manualReset;
+  p->_state = initialSignaled ? TRUE : FALSE;
+  p->_created = 1;
+  return 0;
+}
+
+WRes Event_Set(CEvent *p) { p->_state = TRUE; return 0; }
+WRes Event_Reset(CEvent *p) { p->_state = FALSE; return 0; }
+WRes Event_Close(CEvent *p) { p->_created = 0; return 0; }
+
+WRes Event_Wait(CEvent *p)
+{
+  if (!p->_state)
+    return EAGAIN;
+  if (!p->_manual_reset)
+    p->_state = FALSE;
+  return 0;
+}
+
+WRes Semaphore_Create(CSemaphore *p, UInt32 initiallyCount, UInt32 maxCount)
+{
+  p->_count = initiallyCount;
+  p->_maxCount = maxCount;
+  p->_created = 1;
+  return 0;
+}
+
+WRes Semaphore_ReleaseN(CSemaphore *p, UInt32 releaseCount)
+{
+  if (releaseCount < 1 || releaseCount > p->_maxCount - p->_count)
+    return EINVAL;
+  p->_count += releaseCount;
+  return 0;
+}
+
+WRes Semaphore_Wait(CSemaphore *p)
+{
+  if (p->_count == 0)
+    return EAGAIN;
+  p->_count--;
+  return 0;
+}
+
+WRes Semaphore_Close(CSemaphore *p) { p->_created = 0; return 0; }
+WRes CriticalSection_Init(CCriticalSection *p) { (void)p; return 0; }
+
