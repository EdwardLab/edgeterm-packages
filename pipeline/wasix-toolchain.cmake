set(CMAKE_SYSTEM_NAME WASI)
set(CMAKE_SYSTEM_PROCESSOR wasm32)
set(UNIX TRUE)
set(WIN32 FALSE)

set(CMAKE_C_COMPILER "$ENV{WASI_SDK_BIN}/clang")
set(CMAKE_CXX_COMPILER "$ENV{WASI_SDK_BIN}/clang++")
set(CMAKE_C_COMPILER_TARGET wasm32-wasi)
set(CMAKE_CXX_COMPILER_TARGET wasm32-wasi)
set(CMAKE_AR "$ENV{WASI_SDK_BIN}/llvm-ar")
set(CMAKE_RANLIB "$ENV{WASI_SDK_BIN}/llvm-ranlib")

set(CMAKE_SYSROOT "$ENV{WASIX_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH "$ENV{WASIX_SYSROOT}" "$ENV{EDGETERM_PREFIX}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_CXX_STANDARD_LIBRARIES "-lc++ -lc++abi")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-Wl,--export=__stack_pointer -Wl,--export=__heap_base -Wl,--export=__data_end")
